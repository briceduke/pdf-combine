# Blob — required for heavy merge browser uploads (handleUpload).
# Store pdf-combine-blob is connected; pull with: vercel env pull .env.local --yes
BLOB_READ_WRITE_TOKEN=

# Set automatically when the Blob store is connected to the Vercel project.
# pdf-combine-blob is store_hSXUsRUrLNOmzqZt.
BLOB_STORE_ID=

# Populated on Vercel deployments. Locally: vercel env pull .env.local --yes
# (expires ~12 hours). Workflows use this — no Trigger.dev keys.
VERCEL_OIDC_TOKEN=

# Neon Postgres (pooled) for Better Auth users/sessions.
# Create a Neon DB named pdf-combine on the Vercel team (Storage → Neon),
# then paste the pooled connection string. Do not commit the value.
DATABASE_URL=

# Direct (non-pooler) URL is only needed if you run schema tools that cannot
# use PgBouncer. npm run db:migrate works with the pooled URL.
# DATABASE_URL_UNPOOLED=

# Better Auth. Generate with: openssl rand -base64 32
# Set on Vercel for Preview + Production. Never commit the value.
BETTER_AUTH_SECRET=

# Production only: https://pdf.briceduke.dev
# Leave unset on Preview so magic-link URLs use https://$VERCEL_URL
BETTER_AUTH_URL=

# Optional public alias of the app origin (same rules as BETTER_AUTH_URL).
NEXT_PUBLIC_APP_URL=

# Resend (resend.com). Ship/Brice wires this after the domain is verified.
RESEND_API_KEY=

# Must match a verified Resend domain. Example after DNS is live:
# RESEND_FROM_EMAIL=PDF Combine <auth@pdf.briceduke.dev>
# Do not use onboarding@resend.dev in production.
RESEND_FROM_EMAIL=
