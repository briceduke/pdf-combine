{
  "name": "pdf-combine",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "verify:merge": "node --experimental-strip-types scripts/verify-merge.ts",
    "verify:preview": "node --experimental-strip-types scripts/verify-preview.ts",
    "verify:limits": "node --experimental-strip-types scripts/verify-limits.ts",
    "verify:auth": "node --experimental-strip-types scripts/verify-auth.ts",
    "smoke:heavy": "node --experimental-strip-types scripts/smoke-heavy-merge.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate-auth.ts",
    "verify": "npm run verify:merge && npm run verify:preview && npm run verify:limits && npm run verify:auth"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.7",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
